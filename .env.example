# Salin ke Vercel Project Settings > Environment Variables. Jangan commit API key asli.
GEMINI_API_KEY=isi_api_key_gemini_di_sini
GEMINI_MODEL=gemini-2.5-flash
# Opsional: origin penuh situs produksi, misalnya https://health-quest-kamu.vercel.app
ALLOWED_ORIGIN=
# Dibutuhkan login username/password. Public key boleh dikirim ke browser oleh /api/config.
SUPABASE_URL=https://project-ref.supabase.co
SUPABASE_PUBLISHABLE_KEY=isi_publishable_key
# Hanya untuk backend; jangan pernah dikirim ke browser atau commit nilai aslinya.
SUPABASE_SECRET_KEY=isi_secret_key
# Alternatif legacy bila project belum memakai key baru:
# SUPABASE_ANON_KEY=isi_anon_key
# SUPABASE_SERVICE_ROLE_KEY=isi_service_role_key
